# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore

# Główne katalogi tymczasowe i lokalne Unity
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
.utmp/
*.log

# Sceny ratunkowe po crashu Unity
/[Aa]ssets/[_][Rr]ecovery/
/[Aa]ssets/[_][Rr]ecovery.meta

# Pliki kopii zapasowych Blendera
*.blend1
*.blend1.meta

# Zrzuty pamięci i nagrania
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Edytory kodu i IDE (Rider, VS, VS Code)
.idea/
.vs/
.vscode/
.consulo/
ExportedObj/
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# Cache Gradle
.gradle/

# Wygenerowane pliki projektów i rozwiązań C#
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Pliki .meta dla wygenerowanych plików debugowania
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Raporty o błędach
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# Paczki i pliki wynikowe budowania
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Pliki tymczasowe TestRunnera
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Addressables
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting - cały wygenerowany katalog wraz z plikiem .meta
/[Aa]ssets/Unity.VisualScripting.Generated/
/[Aa]ssets/Unity.VisualScripting.Generated.meta

# Cache zależności scen w Assets
/[Aa]ssets/[Ss]ceneDependencyCache*

# Pliki systemowe (Linux, Windows, macOS)
*~
.directory
.Trash-*
.fuse_hidden*
.DS_Store
Thumbs.db
Thumbs.db:encryptstream
Desktop.ini
